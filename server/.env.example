# Insight Miner backend configuration. Copy to server/.env and fill in secrets.
# server/.env is gitignored — never commit real keys.

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=

# Model per AI stage — a system-config decision, not application logic. No
# runtime switching, no UI dropdown; change here and redeploy. Must be valid
# Anthropic model IDs (see the claude-api skill / platform.claude.com).
ANTHROPIC_SUMMARIZATION_MODEL=claude-haiku-4-5
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# --- Embeddings (open-source sentence-transformers, runs locally — zero API cost) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Database (SQLite single-file DB; no Docker, no external service) ---
DATABASE_URL=sqlite:///./insight_miner.db

# --- CORS (frontend origin) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Ingestion (CSV upload batching & error reporting) ---
INTERNAL_BATCH_SIZE=1000
MAX_REPORTED_ERRORS=100

# --- Clustering (unsupervised grouping via HDBSCAN + UMAP dimensionality reduction) ---
# Parameters for HDBSCAN clustering algorithm
CLUSTERING_MIN_CLUSTER_SIZE=15
CLUSTERING_MIN_SAMPLES=5
# Dimensionality to reduce embeddings to before clustering (default: 50D)
CLUSTERING_REDUCED_DIMENSIONS=50
# Random seed for all stochastic steps (UMAP, HDBSCAN) — ensures deterministic runs
CLUSTERING_RANDOM_SEED=42
# Number of new embeddings required to trigger incremental re-clustering (default: 10)
CLUSTERING_INCREMENTAL_THRESHOLD=10

# --- Cluster summarization (Claude-powered, on-demand, cached) ---
# How long cached summaries remain valid before re-generating (hours)
SUMMARY_CACHE_TTL_HOURS=24
# Token budget for the cluster sample sent to Claude (prevents huge prompts)
SUMMARIZATION_MAX_SAMPLE_TOKENS=8000
# Max completion tokens for the Claude summary response
SUMMARIZATION_MAX_TOKENS=1024
